{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 120,
      "paths": ["src/**", "tests/**", "scripts/**", "anaforge/**", "requirements.txt", "vbd.runtime.json"]
    },
    {
      "id": "fixture-path",
      "argv": [".venv/bin/python", "scripts/run_fixture.py", "logs/stage0_fixture"],
      "timeout_s": 60,
      "paths": ["src/**", "scripts/**", "tests/**"]
    },
    {
      "id": "anaforge-sanity",
      "argv": [".venv/bin/python", "anaforge/scripts/sanity_anaforge.py"],
      "timeout_s": 60,
      "paths": ["anaforge/**", "tests/test_anaforge_laws.py"]
    }
  ]
}
